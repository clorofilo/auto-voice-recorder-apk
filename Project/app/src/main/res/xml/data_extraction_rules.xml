<?xml version="1.0" encoding="utf-8"?><!--
   Backup / device-transfer rules for Android 12 (API 31) and higher; older
   versions use backup_rules.xml. Keep both files in sync.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Excluded (see backup_rules.xml for the reasons): the EncryptedSharedPreferences
   file, whose Keystore master key is never transferred, and the recordings
   database and audio files.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_lock_prefs.xml" />
        <exclude domain="database" path="recordings.db" />
        <exclude domain="database" path="recordings.db-shm" />
        <exclude domain="database" path="recordings.db-wal" />
        <exclude domain="database" path="recordings.db-journal" />
        <exclude domain="file" path="recordings/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_lock_prefs.xml" />
        <exclude domain="database" path="recordings.db" />
        <exclude domain="database" path="recordings.db-shm" />
        <exclude domain="database" path="recordings.db-wal" />
        <exclude domain="database" path="recordings.db-journal" />
        <exclude domain="file" path="recordings/" />
    </device-transfer>
</data-extraction-rules>
